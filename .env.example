# Discord credentials (user token method - no admin required)
DISCORD_USER_TOKEN=your-user-token-here
DISCORD_GUILD_ID=your-guild-id-here

# Public GUI access (required when HOST is not localhost)
GUI_USERNAME=admin
GUI_PASSWORD=replace-with-a-strong-private-password

# Export settings
EXPORT_LIMIT=500
EXPORT_DAYS=30
